{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dozo",
  "version": "0.1.0",
  "identifier": "dev.ssilistre.dozo",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
