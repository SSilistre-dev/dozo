{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dozo",
  "version": "0.1.0",
  "identifier": "dev.ssilistre.dozo",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5MUMwRDU5NDQ5MDc3MDEKUldRQmQ1QkVXUTBjdWR5NmtRRkZGSy9xRHFkVHIvUzNBU2Q0MEJKSGZFRlZobE9YVkxxclpFTnUK",
      "endpoints": [
        "https://github.com/SSilistre-dev/dozo/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
