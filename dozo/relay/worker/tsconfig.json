{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@rakazo/contracts": ["../../../packages/contracts/src/dozo-relay.ts"],
      "@dozo/relay-core/*": ["./node_modules/.relay-core-types/core/src/*"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src", "test", "vitest.config.ts"]
}
