    {
      "file": "apps/web/src/pages/Onboarding.tsx",
      "find": "import { ModelStep } from \"./onboarding/model-step\";",
      "replace": "import { ModelStep } from \"./onboarding/dozo-model-step\";",
      "requires": ["apps/web/src/pages/onboarding/dozo-model-step.tsx"],
