      "find": "env = dict(env, USER=\"rakazo\", LOGNAME=\"rakazo\")",
      "replace": "env = dict(env, USER=\"dozo\", LOGNAME=\"dozo\")",
      "reason": "login name for the in-app terminal when the host uid has no passwd entry"
    },
    {
      "file": "packages/core/src/node/terminal-server.ts",
      "find": "passwd += \"rakazo:x:%d:%d:Rakazo:",
      "replace": "passwd += \"dozo:x:%d:%d:Dozo:",
      "reason": "passwd entry shown by whoami"
    },
    {
      "file": "packages/core/src/node/terminal-server.ts",
      "find": "group += \"rakazo:x:%d:",
      "replace": "group += \"dozo:x:%d:",
      "reason": "group entry"
    },
    {
      "file": "packages/adapters/src/desktop-guard-words.ts",
      "find": "LOGNAME: \"rakazo\",",
      "replace": "LOGNAME: \"dozo\",",
      "reason": "must match the image user"
    },
    {
      "file": "packages/adapters/src/desktop-guard-words.ts",
      "find": "USER: \"rakazo\",",
      "replace": "USER: \"dozo\",",
      "reason": "must match the image user"
    },
    {
      "file": "packages/adapters/src/computer-support.ts",
      "find": "[\\\\/]home[\\\\/]rakazo",
      "replace": "[\\\\/]home[\\\\/]dozo",
      "reason": "regex twin of the /home literal rule"
    },
    {
      "file": "packages/adapters/src/cli-models/claude-code/stream.ts",
      "find": "const TOOL_SERVER = \"rakazo\";",
      "replace": "const TOOL_SERVER = \"dozo\";",
      "reason": "tool names the model sees (mcp__<server>__<tool>); every user of it goes through the constant"
    },
    {
      "file": "packages/page-kit/src/components.ts",
      "find": "PAGE_KIT_MODULE = \"rakazo/page\"",
      "replace": "PAGE_KIT_MODULE = \"dozo/page\"",
      "reason": "import specifier the model writes in pages; validate.ts and runtime.tsx use the constant"
    },
    {
      "file": "packages/page-kit/src/guide.ts",
      "find": "\"rakazo/page\"",
      "replace": "\"dozo/page\"",
      "reason": "the guide shown to the model names the same specifier"
    },
    {
      "file": "packages/adapters/src/remote-mcp.ts",
      "find": "{ name: \"rakazo\", version: \"0.1.0\" }",
      "replace": "{ name: \"dozo\", version: \"0.1.0\" }",
      "reason": "client name announced to third-party MCP servers"
    },
    {
      "file": "packages/adapters/src/mcp-transport.ts",
      "find": "this.clientOptions.name ?? \"rakazo\"",
      "replace": "this.clientOptions.name ?? \"dozo\"",
      "reason": "default MCP client name"
