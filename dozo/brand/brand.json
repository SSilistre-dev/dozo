    "apps/web/public/icon-192.png": "web/icon-192.png",
    "apps/web/public/icon-512.png": "web/icon-512.png"
  },
  "literals": [
    {
      "find": "/home/rakazo",
      "replace": "/home/dozo",
      "reason": "home directory of the bot computer: shell prompt, the model's system prompt, supervisor, image; every in-scope use is renamed together"
    },
    {
      "find": "rakazo-shared",
      "replace": "dozo-shared",
      "reason": "reserved Honcho peer id, quoted in the settings validation text and its translations; code and message change together (fresh deployment)"
    },
    {
      "find": "rakazo-runtime:x:",
      "replace": "dozo-runtime:x:",
      "files": [
        "infra/sandboxes/computer/user-env.sh"
      ],
      "reason": "passwd and group name for arbitrary host uids; whoami shows it"
    },
    {
      "find": "RakazoIntrospection",
      "replace": "DozoIntrospection",
      "files": [
        "packages/adapters/src/graphql-connectors.ts"
      ],
      "reason": "GraphQL operation name sent to servers users connect; only a label"
    },
    {
      "find": "`rakazo-${server.slug}`",
      "replace": "`dozo-${server.slug}`",
      "files": [
        "packages/adapters/src/mcp-connector.ts"
      ],
